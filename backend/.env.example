APP_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Configuracion de SQL Server con autenticacion de Windows
# Instancia predeterminada local. Para SQL Express: localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=TurismoPosadas
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_CONNECT_TIMEOUT=5
DB_ECHO=false

# Generar localmente: python -m scripts.configure_auth
# No compartir esta clave ni subir .env al repositorio.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=turismo-posadas-api
JWT_AUDIENCE=turismo-posadas-client

# Plazo de retención de inventario al reservar (entre 1 y 120 minutos).
RESERVA_PAGO_MINUTOS=15

# AE4 local infrastructure. Never commit real credentials.
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://localhost:5672/%2F
AE4_MESSAGING_ENABLED=true
AE4_QUEUE_PREFIX=ae4
REDIS_TIMEOUT_SECONDS=0.2
AVAILABILITY_CACHE_TTL_SECONDS=10
REDIS_LOCK_TTL_MS=5000
REDIS_LOCK_WAIT_SECONDS=0.15
AE4_RETRY_DELAYS_MS=5000,30000,120000
OUTBOX_LEASE_SECONDS=15
OUTBOX_MAX_ATTEMPTS=10

# Macro 3. Windows local: keep DB_USER empty for integrated authentication.
# Compose supplies separate SQL credentials through mounted secret files.
DB_USER=
DB_PASSWORD=
DB_PASSWORD_FILE=
DB_PORT=0
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_QUERY_TIMEOUT=5
DB_LOCK_TIMEOUT_MS=2000
DB_POOL_TIMEOUT=2
JWT_SECRET_KEY_FILE=
REDIS_URL_FILE=
RABBITMQ_URL_FILE=
METRICS_TOKEN=
METRICS_TOKEN_FILE=
SERVICE_NAME=core-api
LOG_JSON=true
LOG_LEVEL=INFO
TRACING_ENABLED=true
TRACE_SAMPLE_RATIO=1
METRICS_PORT=0
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
PAYMENT_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=65536
# Empty URL preserves single-process native execution.
AVAILABILITY_URL=
AVAILABILITY_CONNECT_TIMEOUT=0.3
AVAILABILITY_READ_TIMEOUT=1
AVAILABILITY_DEADLINE_SECONDS=1.5
AVAILABILITY_RETRIES=1
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=10
RABBITMQ_SOCKET_TIMEOUT=2
RABBITMQ_STACK_TIMEOUT=5
RABBITMQ_BLOCKED_TIMEOUT=3
RABBITMQ_HEARTBEAT=30
